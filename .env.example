# Local synthetic demo only. Never paste provider secrets into the browser.
DATABASE_URL=sqlite:///./tracelens.db
CHECKPOINT_PATH=
LLM_MODE=mock
RETRIEVAL_MODE=lexical
TOOL_TRANSPORT=direct
DEMO_PASSWORD=tracelens-local
MCP_SIGNING_SECRET=tracelens-local-scope-secret-v1
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Workflow budgets
MAX_TOOL_CALLS=6
MAX_LLM_CALLS=3
MAX_REPAIRS=1
MAX_TOKEN_BUDGET=16000
WALL_CLOCK_TIMEOUT_SECONDS=45

# Live LLM provider (server-side only; required when LLM_MODE=live)
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# LLM_ALLOW_DEGRADED_FALLBACK=false
# LLM_INPUT_PRICE_PER_1M=
# LLM_OUTPUT_PRICE_PER_1M=
# LLM_PRICING_AS_OF=

# Independent embedding provider (required when RETRIEVAL_MODE=hybrid)
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
